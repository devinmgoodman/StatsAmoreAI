# Template for .env.prod on the Mac Mini ONLY. Never commit the real file.
# Store it OUTSIDE the repo (e.g. ~/statsamore/.env.prod) and set the GitHub variable PROD_ENV_FILE to that path.
POSTGRES_USER=stats_amore_user
POSTGRES_PASSWORD=
POSTGRES_DB=stats_amore

NODE_ENV=production
PORT=8080
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stats_amore
DB_USER=stats_amore_user
DB_PASSWORD=
CORS_ORIGIN=https://statsamore.com

# Caddy / public API hostname (CNAME in SiteGround DNS -> <DUCKDNS_SUBDOMAIN>.duckdns.org)
API_HOSTNAME=api.statsamore.com
ACME_EMAIL=

# DuckDNS updater
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# Backups: absolute path OUTSIDE the repo checkout
BACKUP_DIR=
# Optional off-site copy (Backblaze B2 via rclone); leave RCLONE_REMOTE empty to skip
RCLONE_REMOTE=
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=
