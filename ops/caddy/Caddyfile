{
	email {$ACME_EMAIL}
}

{$API_HOSTNAME} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8080 {
			health_uri /api/v1/health
			health_interval 30s
		}
	}

	handle {
		respond "Not found" 404
	}
}
